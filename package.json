{
  "name": "enterprise-ledger-engine",
  "version": "1.0.0",
  "description": "Enterprise-grade immutable double-entry ledger engine featuring cryptographic audit trails, zero-sum balance invariants, and high-performance reconciliation pipelines.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test": "vitest run",
    "test:invariants": "vitest run tests/invariants"
  },
  "keywords": [
    "fintech",
    "immutable-ledger",
    "double-entry-bookkeeping",
    "cryptographic-audit",
    "reconciliation",
    "distributed-transactions",
    "zero-sum-invariant"
  ],
  "author": "Valelethia Johnson <valelethiajohnson927@hotmail.com> (https://github.com/ValelethiaJohnson)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ValelethiaJohnson/enterprise-ledger-engine.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "pino": "^9.4.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "eslint": "^9.10.0",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
